<html>
  <head>
    <title>stonks</title>
    <meta name="robots" content="noindex,nofollow">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      body { font-family: monospace; }
      table { border-collapse: collapse; }
      th, td { padding: 4px 8px; text-align: left; border-bottom: 1px solid #ddd; }
      th { border-bottom: 2px solid #333; }
      .buy { color: green; }
      .sell { color: red; }
      .right { text-align: right; }
      #chart-container { max-width: 800px; margin-bottom: 24px; }
    </style>
  </head>
  <body>
    <h2>stonks</h2>
    <div id="chart-container">
      <canvas id="networth"></canvas>
    </div>
    <table>
      <tr>
        <th>date</th>
        <th>nick</th>
        <th>action</th>
        <th>symbol</th>
        <th class="right">amount</th>
        <th class="right">shares</th>
        <th class="right">price/share</th>
      </tr>
      {{range .transactions}}
      <tr>
        <td>{{time .CreatedAt}}</td>
        <td>{{.Nick}}</td>
        <td class="{{if eq .Verb "BUY"}}buy{{else if eq .Verb "SELL"}}sell{{end}}">{{.Verb}}</td>
        <td>{{.Symbol}}</td>
        <td class="right">${{printf "%.0f" .AmountUsd}}</td>
        <td class="right">{{if ne .Verb "CREDIT"}}{{printf "%.4g" .Shares}}{{end}}</td>
        <td class="right">{{if ne .Verb "CREDIT"}}${{printf "%.2f" .Price}}{{end}}</td>
      </tr>
      {{end}}
    </table>
    <script>
      const data = {{safeJS .chartJSON}};
      const colors = [
        '#e6194b', '#3cb44b', '#4363d8', '#f58231', '#911eb4',
        '#42d4f4', '#f032e6', '#bfef45', '#fabed4', '#469990',
      ];
      const datasets = [];
      let i = 0;
      for (const [nick, points] of Object.entries(data)) {
        const color = colors[i++ % colors.length];
        datasets.push({
          label: nick,
          data: points.map(p => ({x: p.date, y: Math.round(p.value)})),
          borderColor: color,
          backgroundColor: color,
          tension: 0.1,
          pointRadius: 3,
        });
      }
      // Nicks cover different dates, so the axis needs the sorted union of them.
      // Otherwise chart.js orders dates by first appearance across datasets.
      const labels = [...new Set(Object.values(data).flat().map(p => p.date))].sort();
      new Chart(document.getElementById('networth'), {
        type: 'line',
        data: {labels, datasets},
        options: {
          scales: {
            x: {type: 'category', title: {display: true, text: 'date'}},
            y: {title: {display: true, text: 'net worth ($)'}},
          },
          plugins: {
            title: {display: true, text: 'net worth over time'},
          },
        },
      });
    </script>
  </body>
</html>
